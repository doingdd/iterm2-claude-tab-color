#!/usr/bin/env bash
set -euo pipefail

readonly CLAUDE_LANES_REPO="https://github.com/hanzhangzzz/claude-lanes"
readonly CODING_USAGE_BAR_REPO="https://github.com/hanzhangzzz/coding-usage-bar"
readonly TAB_COLOR_REPO="https://github.com/hanzhangzzz/iterm2-ai-tab-color"

usage() {
    cat <<'EOF'
BurnKit - directory for three standalone AI coding tools

Usage:
  burnkit projects   Show standalone projects and install commands
  burnkit doctor     Check whether the standalone tools are available
  burnkit --help

BurnKit no longer bundles, installs, uninstalls, or proxies these tools.
Use each standalone project's own command instead.
EOF
}

projects() {
    cat <<EOF
Claude Lanes
  Explicit per-window Claude provider routing
  Repository: $CLAUDE_LANES_REPO
  Install:    npm install -g claude-lanes
  Command:    c

Coding Usage Bar
  Coding-plan usage in the macOS menu bar
  Repository: $CODING_USAGE_BAR_REPO
  Install:    npx coding-usage-bar install
  Command:    coding-usage-bar doctor

iTerm2 AI Tab Color
  Attention-state colors for Claude Code and Codex tabs
  Repository: $TAB_COLOR_REPO
  Install:    clone the repository, then run ./install.sh
EOF
}

ok() {
    printf 'OK   %s\n' "$1"
}

fail() {
    printf 'FAIL %s\n' "$1"
    DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1))
}

doctor() {
    local DOCTOR_FAILURES=0
    local uid
    uid="$(id -u)"

    if command -v c >/dev/null 2>&1 && realpath "$(command -v c)" | grep -Fq '/claude-lanes/'; then
        ok "Claude Lanes: $(command -v c)"
    else
        fail "Claude Lanes is not installed. Run: npm install -g claude-lanes"
    fi

    if command -v coding-usage-bar >/dev/null 2>&1; then
        ok "Coding Usage Bar: $(command -v coding-usage-bar)"
    else
        fail "Coding Usage Bar is not installed. Run: npx coding-usage-bar install"
    fi

    if launchctl print "gui/$uid/io.github.hanzhangzzz.iterm2-ai-tab-color" >/dev/null 2>&1; then
        ok "iTerm2 AI Tab Color launchd agent is loaded"
    else
        fail "iTerm2 AI Tab Color is not running. See: $TAB_COLOR_REPO"
    fi

    if [ "$DOCTOR_FAILURES" -ne 0 ]; then
        printf '\n%d check(s) failed. Run `burnkit projects` for standalone install commands.\n' "$DOCTOR_FAILURES" >&2
        return 1
    fi

    printf '\nAll standalone tools are available.\n'
}

legacy_command() {
    printf 'Error: `burnkit %s` was removed when the tools became standalone projects.\n' "$*" >&2
    printf 'Run `burnkit projects` for the current repositories and commands.\n' >&2
    return 2
}

case "${1:---help}" in
    -h|--help|help)
        usage
        ;;
    projects)
        [ "$#" -eq 1 ] || legacy_command "$@"
        projects
        ;;
    doctor)
        [ "$#" -eq 1 ] || legacy_command "$@"
        doctor
        ;;
    install|uninstall|router|burn|status)
        legacy_command "$@"
        ;;
    *)
        printf 'Error: unknown command: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
